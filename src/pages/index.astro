---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Recognition from "../components/Recognition.astro";
import Footer from "../components/Footer.astro";

// Title + meta derived from the positioning line in BRIEF.md.
const title = "Omer Ali Omer";
const description =
  "Omer Ali Omer is a Platform Engineer at IBM Client Engineering, building cloud-native platforms and enterprise AI, and moving towards technical architecture with a career pointed at the Gulf.";
---

<Base title={title} description={description}>
  <Hero />
  <SelectedWork />
  <Recognition />
  <Footer slot="footer" />
</Base>
